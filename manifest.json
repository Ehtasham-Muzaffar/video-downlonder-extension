{
  "manifest_version": 3,
  "name": "Nova Video Downloader - FB, Insta & Web",
  "version": "1.0.1",
  "description": "Download full HD videos from Facebook, Instagram, and web pages with 1 click. Features auto-detection, quality selection & video previews.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "webRequest",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Nova Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "content/interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/content.css",
        "content/interceptor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
